<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <ProjectReference Include="../../src/ParticleLife.Viewer/ParticleLife.Viewer.csproj" />
    <ProjectReference Include="../../src/ParticleLife.Cli/ParticleLife.Cli.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
    <Compile Include="../../src/ParticleLife.MonoGame/ViewerOptions.cs" Link="Host/ViewerOptions.cs" />
    <None Include="../../examples/experiments/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
