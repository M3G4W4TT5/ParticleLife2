<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/Branding/Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ParticleLife.MonoGame.Compatibility" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <ProjectReference Include="../ParticleLife.Viewer/ParticleLife.Viewer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/Branding/splash.png" />
    <EmbeddedResource Include="Assets/Branding/Icon.bmp" LogicalName="Icon.bmp" />
    <EmbeddedResource Include="Assets/Fonts/plex-sans-atlas.png" />
    <EmbeddedResource Include="Assets/Fonts/plex-sans-metrics.json" />
    <None Update="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Lucide/lucide-atlas.png" />
    <None Update="Assets/Lucide/LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/Lucide/FEATHER-LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
